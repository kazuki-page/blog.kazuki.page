# WordPress からの移行にともなうリダイレクト。
#
# 書式: <元パス> <転送先> <ステータス>
# 上から順に評価され、最初に一致したものが使われる。
# ワイルドカードより先に個別ルールを書くこと。

# --- 旧カテゴリ ---------------------------------------------------------
# weekly / monthly / yearly はカテゴリからタグへ移した（カテゴリは blog と diary の 2 つに集約）
/category/weekly/     /tags/weekly/       301
/category/monthly/    /tags/monthly/      301
/category/yearly/     /tags/yearly/       301
/category/*           /categories/:splat  301
/tag/*                /tags/:splat        301

# --- 固定ページ ---------------------------------------------------------
# /blog/ と /diary/ はカテゴリの一覧ページだった
/blog/                /categories/blog/   301
/diary/               /categories/diary/  301
# 中身は kazuki.page の問い合わせ先へのリンクだけだった
/contact/             https://kazuki.page/contact/  301

