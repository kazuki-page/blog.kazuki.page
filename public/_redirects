# WordPress が自動生成していた URL からのリダイレクト。
# 記事本体の URL は変更していないため、ここに書くのは周辺 URL のみ。
#
# 書式: <元パス> <転送先> <ステータス>
# 上にあるルールから順に評価される。

# RSS — 購読者が失われるため必須
/feed/                /rss.xml            301
/feed                 /rss.xml            301
/feed/atom/           /rss.xml            301

# カテゴリ・タグ（WordPress は単数形、こちらは複数形）
/category/*           /categories/:splat  301
/tag/*                /tags/:splat        301

# サイトマップ（SEO プラグインの命名から Astro の命名へ）
/sitemap_index.xml    /sitemap-index.xml  301

# 以下は意図的にリダイレクトしていない（すべて 404 のままでよい）:
#   /2024/05/     日付アーカイブ。サイト内のどこからもリンクしていない
#   /author/xxx/  もともと 404
#   /?p=123       該当 URL が存在しないことを確認済み
#   /page/N/      現行も 1 ページ 100 件のため、ページ数が一致する
