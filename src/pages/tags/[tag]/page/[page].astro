---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import PostList from '../../../../components/PostList.astro';
import Pagination from '../../../../components/Pagination.astro';
import { getPublishedPosts, paginateItems } from '../../../../lib/posts';
import { tagIds, tags, tagPath } from '../../../../data/tags';

// 1 ページ目は /tags/{tag}/ が担当するので、ここでは 2 ページ目以降だけ。
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();

  return tagIds.flatMap((id) => {
    const filtered = posts.filter((p) => p.data.tags.includes(id));

    return paginateItems(filtered)
      .filter((p) => p.page > 1)
      .map((p) => ({
        params: { tag: tags[id].slug, page: String(p.page) },
        props: { id, ...p },
      }));
  });
};

const { id, page, totalPages, items } = Astro.props;
const meta = tags[id];
---

<BaseLayout title={`#${meta.name} (${page}ページ目)`} description={meta.description} noindex>
  <h1>#{meta.name}</h1>

  <PostList posts={items} />
  <Pagination base={tagPath(id)} page={page} totalPages={totalPages} />
  <Breadcrumb
    items={[
      { label: 'Tags', href: '/tags/' },
      { label: `#${meta.name}`, href: tagPath(id) },
      { label: `${page}ページ目` },
    ]}
  />
</BaseLayout>
