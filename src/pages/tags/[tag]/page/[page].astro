---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import PostList from '../../../../components/PostList.astro';
import Pagination from '../../../../components/Pagination.astro';
import { getPublishedPosts, paginateItems } from '../../../../lib/posts';
import { tags, tagPath, type TagName } from '../../../../data/tags';

// 1 ページ目は /tags/{tag}/ が担当するので、ここでは 2 ページ目以降だけ。
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();

  return (Object.keys(tags) as TagName[]).flatMap((name) => {
    const filtered = posts.filter((p) => p.data.tags.includes(name));

    return paginateItems(filtered)
      .filter((p) => p.page > 1)
      .map((p) => ({
        params: { tag: tags[name].slug, page: String(p.page) },
        props: { name, ...p },
      }));
  });
};

const { name, page, totalPages, items } = Astro.props;
---

<BaseLayout title={`#${name} (${page}ページ目)`} description={tags[name].description} noindex>
  <h1>#{name}</h1>

  <PostList posts={items} />
  <Pagination base={tagPath(name)} page={page} totalPages={totalPages} />
  <Breadcrumb
    items={[
      { label: 'Tags', href: '/tags/' },
      { label: `#${name}`, href: tagPath(name) },
      { label: `${page}ページ目` },
    ]}
  />
</BaseLayout>
