---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts, paginateItems } from '../../../lib/posts';
import { tags, tagPath, type TagName } from '../../../data/tags';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();

  return (Object.keys(tags) as TagName[]).map((name) => {
    const filtered = posts.filter((p) => p.data.tags.includes(name));
    const pages = paginateItems(filtered);

    return {
      params: { tag: tags[name].slug },
      props: { name, items: pages[0].items, totalPages: pages[0].totalPages },
    };
  });
};

const { name, items, totalPages } = Astro.props;
const meta = tags[name];
---

<BaseLayout title={`#${name}`} description={meta.description ?? `${name} の記事一覧。`}>
  <h1>#{name}</h1>
  {meta.description && <p class="desc">{meta.description}</p>}

  <PostList posts={items} />
  <Pagination base={tagPath(name)} page={1} totalPages={totalPages} />
</BaseLayout>

<style>
  .desc {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
