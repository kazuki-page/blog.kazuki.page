---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { tags, tagPath, type TagName } from '../../data/tags';

const posts = await getPublishedPosts();

const entries = (Object.keys(tags) as TagName[])
  .map((name) => ({
    name,
    ...tags[name],
    count: posts.filter((p) => p.data.tags.includes(name)).length,
  }))
  .filter((t) => t.count > 0)
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="Tags" description="タグの一覧。">
  <h1>Tags</h1>

  <ul class="taxonomy">
    {
      entries.map((tag) => (
        <li>
          <a href={tagPath(tag.name)}>#{tag.name}</a>
          <span class="count">{tag.count}</span>
          <p class="desc">{tag.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .taxonomy {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }

  .taxonomy li {
    margin: 1.5rem 0;
  }

  .count {
    color: var(--muted);
    font-size: 0.85rem;
    margin-left: 0.5rem;
  }

  .desc {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.25rem 0 0;
  }
</style>
