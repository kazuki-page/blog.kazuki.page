---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getPublishedPosts } from '../../lib/posts';
import { tagIds, tags, tagPath } from '../../data/tags';

const posts = await getPublishedPosts();

const entries = tagIds
  .map((id) => ({
    ...tags[id],
    count: posts.filter((p) => p.data.tags.includes(id)).length,
  }))
  .filter((t) => t.count > 0)
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="Tags" description="タグの一覧。">
  <h1>Tags</h1>

  <ul class="taxonomy">
    {
      entries.map((tag) => (
        <li>
          <a href={tagPath(tag.id)}>#{tag.name}</a>
          <span class="count">{tag.count}</span>
          {tag.description && <p class="desc">{tag.description}</p>}
        </li>
      ))
    }
  </ul>
  <Breadcrumb items={[{ label: 'Tags' }]} />
</BaseLayout>

<style>
  .taxonomy {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }

  .taxonomy li {
    margin: 1.5rem 0;
  }

  .count {
    color: var(--muted);
    font-size: 0.85rem;
    margin-left: 0.5rem;
  }

  .desc {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.25rem 0 0;
  }
</style>
