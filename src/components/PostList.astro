---
import { postPath, formatDate, type Post } from '../lib/posts';
import { categoryPath } from '../data/categories';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">記事がありません。</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <a class="post-title" href={postPath(post)}>
            {post.data.title}
            {post.data.draft && <span class="draft"> [下書き]</span>}
          </a>
          <a class="post-category" href={categoryPath(post.data.category)}>
            {post.data.category}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-list {
    list-style: none;
    margin: 2rem 0;
    padding: 0;
  }

  .post-list li {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    margin: 0.75rem 0;
  }

  time {
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  /* 一覧が青一色にならないよう、タイトルはホバーしたときだけリンク色にする */
  .post-title {
    color: var(--text);
  }

  .post-title:hover {
    color: var(--accent);
  }

  .post-category {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .draft {
    color: #c00;
  }

  @media (max-width: 30rem) {
    .post-list li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
      margin: 1.25rem 0;
    }
  }
</style>
