---
import '../styles/global.css';
import Logo from '../assets/logo.svg';
import HeaderControls from '../components/HeaderControls.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
}

const SITE_NAME = 'blog.kazuki.page';
const DEFAULT_DESCRIPTION = '未来の自分に向けたログ。';
const GA_MEASUREMENT_ID = 'G-LWFDWQB1V1';

// 式の中に書いた <script> は中身が JSX として解釈されてしまうため、
// スクリプト本体は文字列として組み立てて set:html で出力する
const gaSnippet = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_MEASUREMENT_ID}');`;

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage = '/ogp-default.png',
  ogType = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// ブログ開始年から現在年まで。同一年なら単年表示。
const SITE_START_YEAR = 2022;
const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > SITE_START_YEAR ? `${SITE_START_YEAR}-${currentYear}` : `${SITE_START_YEAR}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      テーマは描画前に確定させる。CSS 読み込み後に JS で切り替えると、
      ダークを選んでいる人の再訪時に一瞬白い画面が出る。
      そのため同期実行のインラインスクリプトをここに置いている。
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          document.documentElement.dataset.theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {
          /* localStorage が使えない環境では OS の設定にまかせる */
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />

    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />

    {/* Google アナリティクス。開発中に計測してしまわないよう本番ビルドだけ読み込む */}
    {
      import.meta.env.PROD && (
        <Fragment>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script is:inline set:html={gaSnippet} />
        </Fragment>
      )
    }
  </head>

  <body>
    <header>
      <a href="/" class="site-logo" aria-label={SITE_NAME}>
        <Logo role="img" />
      </a>
      <nav>
        <a href="/categories/">Categories</a>
        <a href="/tags/">Tags</a>
        <a href="/about/">About</a>
        <HeaderControls />
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {copyrightYears} blog.kazuki.page</p>
      <nav>
        <a href="/policy/">Policy</a>
      </nav>
    </footer>
  </body>
</html>
